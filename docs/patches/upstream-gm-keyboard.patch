+/// Native keys for the upstream GM windows; interpreted before chat/gameplay.
+fn admin_key_in(event: &KeyIn) -> Option<(i32, bool)> {
+    let down=event.state==ElementState::Pressed;
+    if down && event.repeat {return None;}
+    let key=match &event.logical_key {
+        Key::Named(NamedKey::ArrowUp)=>19,
+        Key::Named(NamedKey::ArrowDown)=>20,
+        Key::Named(NamedKey::ArrowLeft)=>17,
+        Key::Named(NamedKey::ArrowRight)=>18,
+        Key::Named(NamedKey::Enter)=>13,
+        Key::Named(NamedKey::Escape)|Key::Named(NamedKey::Backspace)=>27,
+        Key::Character(c) if c.eq_ignore_ascii_case("e")=>134,
+        Key::Character(c) if c.eq_ignore_ascii_case("q")=>133,
+        Key::Character(c) if c.eq_ignore_ascii_case("c")=>135,
+        _=>return None,
+    };
+    Some((key,down))

+    fn upstream_gm_windows_receive_native_keys_before_chat_or_movement() {
+        for (name,code) in [("up",19),("down",20),("left",17),("right",18),("enter",13),("e",134),("escape",27),("backspace",27),("q",133),("c",135)] {
+            assert_eq!(admin_key_in(&KeyIn::named(name,true)),Some((code,true)), "{name}");
+            assert_eq!(admin_key_in(&KeyIn::named(name,false)),Some((code,false)), "release {name}");
+        }
+        assert_eq!(admin_key_in(&KeyIn::named("w",true)),None,"unknown keys cannot move the player in a GM window");
+        let repeat=KeyIn{repeat:true,..KeyIn::named("enter",true)};
+        assert_eq!(admin_key_in(&repeat),None,"repeated confirmation must not open chat");
+    }

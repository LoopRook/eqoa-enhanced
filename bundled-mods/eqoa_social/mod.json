    "eqoa.actions.friend_refuse",
    "eqoa.actions.ignore_add",
    "eqoa.actions.ignore_remove",
    "eqoa.actions.guild_invite",
    "eqoa.actions.guild_promote",
    "eqoa.actions.guild_demote",
    "eqoa.actions.guild_kick",
    "eqoa.actions.guild_set_motd",
    "eqoa.actions.guild_accept",
    "eqoa.actions.guild_refuse",
    "eqoa.who.request",
    "eqoa.lfg.search",
    "eqoa.lfg.register",
    "eqoa.lfg.unregister",
    "eqoa.windows.session",
    "eqoa.windows.takeover",
    "eqoa.log.write",
    "eqoa.input.bind",
    "eqoa.input.claim",
